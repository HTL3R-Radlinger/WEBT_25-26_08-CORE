mod.wizards.newContentElement.wizardItems.plugins {
    elements {
        fortune_motd {
            iconIdentifier = content-plugin
            title          = Fortune Cookie – Message of the Day
            description    = Displays the daily fortune-cookie message.
            tt_content_defValues {
                CType = fortune_motd
            }
        }
    }
    show := addToList(fortune_motd)
}
